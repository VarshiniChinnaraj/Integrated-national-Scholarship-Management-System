# ==============================================================
# National Scholarship Portal — Server Environment Variables
# Copy this file to .env and fill in the values before starting.
# ==============================================================

# === Database ===
MONGO_URI=mongodb://127.0.0.1:27017/national_scholarship_db

# === Authentication ===
JWT_SECRET=national_scholarship_secret_key_2026_jwt

# === Server ===
PORT=5000
NODE_ENV=development

# === SMTP Email Configuration (Required for email reminders) ===
# Gmail Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465   (use 465 for SSL/secure=true, 587 for TLS/STARTTLS)
#   SMTP_USER=your_gmail_address@gmail.com
#   SMTP_PASSWORD=your_16_character_app_password   (Gmail App Password, no spaces)
#
# Note: For Gmail, enable 2-Step Verification and generate an App Password at:
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
MAIL_FROM="National Scholarship Portal <your_gmail_address@gmail.com>"
MAIL_FROM_NAME="National Scholarship Portal"

# === Portal URL (used in email reminder links) ===
STUDENT_PORTAL_URL=http://localhost:3001

# === Scholarship Reminder Scheduler ===
# Cron expression for how often the scheduler checks (default: every hour)
REMINDER_CRON=0 * * * *

# Timezone for the cron scheduler and reminder timing (IANA timezone string)
REMINDER_TIMEZONE=Asia/Kolkata

# Hours before deadline for the deadline-day morning reminder (default: 8)
REMINDER_MORNING_HOURS=8

# Hours before deadline for the deadline-day final reminder (default: 2)
REMINDER_FINAL_HOURS=2
